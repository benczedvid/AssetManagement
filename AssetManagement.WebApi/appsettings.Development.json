    "SubjectTemplate": "Eszközkezelő - Nem leadott eszközök - Áruház {0}",
    "SendEmptyReports": false,
    "TestMode": false
  },
  "EndOfDayAssetReport": {
    "Enabled": true,
    "CronExpression": "0 38 11 ? * *",
    "TimeZoneId": "Europe/Budapest",
    "RecipientAddressesTemplate": ["prak_{0}_cz@praktiker.hu", "prak_{0}_Ak@praktiker.hu"],
    "SubjectTemplate": "Eszközkezelő - Nem leadott eszközök - Áruház {0}",
    "SendEmptyReports": false,
    "TestMode": false
  },
  "OverdueAssetReport": {
    "Enabled": false,
    "CronExpression": "0 0/5 * ? * *",
